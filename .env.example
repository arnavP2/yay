# Public / browser (safe to expose)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Server only — required to post loads, quotes, bookings, and bot sessions.
# Never put this in VITE_* variables or client code.
SUPABASE_SERVICE_ROLE_KEY=

# Telegram Bot API token from BotFather (server only).
# TELEGRAM_BOT_TOKEN is an optional alias for the same value.
TELEGRAM_API_KEY=
TELEGRAM_BOT_TOKEN=

# WhatsApp via the existing Twilio/Lovable connector (optional; leave unset if unused)
LOVABLE_API_KEY=
TWILIO_API_KEY=
TWILIO_WHATSAPP_FROM=
BACKHAUL_SHIPPER_PHONE=
